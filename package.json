{
  "name": "vibe-todo",
  "private": true,
  "version": "0.1.0",
  "description": "Aufgaben-App (MS-To-Do-Klon) aus einer Codebase: Browser (PWA), Windows (Electron), Android & iOS (Capacitor)",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "test": "vitest run",
    "sync-server": "node server/sync-server.js",
    "icons": "python3 tools/make-icons.py",
    "screenshots": "node tools/screenshot.mjs",
    "cap:add:android": "npx cap add android",
    "cap:add:ios": "npx cap add ios",
    "cap:sync": "npm run build && npx cap sync",
    "cap:android": "npm run cap:sync && npx cap open android",
    "cap:ios": "npm run cap:sync && npx cap open ios",
    "electron:dev": "npm run build && electron .",
    "electron:dist": "npm run build && electron-builder --config electron-builder.yml --win"
  },
  "dependencies": {
    "idb": "^8.0.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@capacitor/android": "^7.4.4",
    "@capacitor/cli": "^7.4.4",
    "@capacitor/core": "^7.4.4",
    "@capacitor/ios": "^7.4.4",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "electron": "^38.7.0",
    "electron-builder": "^26.0.12",
    "fake-indexeddb": "^6.2.5",
    "playwright": "^1.65.1",
    "typescript": "^5.9.3",
    "vite": "^7.2.6",
    "vitest": "^3.2.4"
  }
}
